# Copier vers .env.local et remplir avec de vraies valeurs (jamais commiter .env.local).

# NextAuth — secret de signature des sessions ET des tokens Bearer mobile (lib/mobile-token.ts).
AUTH_SECRET=

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
PGDATABASE=
PGHOST=
PGHOST_UNPOOLED=
PGPASSWORD=
PGUSER=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=

# Paystack (paiements/abonnement)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# App mobile Android — URL DIRECTE du fichier .apk (pas la page expo.dev/builds/…).
# Récupérer via : cd serveo-mobile && npx eas build:view <BUILD_ID> --json
#   → artifacts.applicationArchiveUrl (ex. https://expo.dev/artifacts/eas/….apk)
# Si vide, le lien « Télécharger l'app » est masqué sur la page d'accueil.
NEXT_PUBLIC_ANDROID_APK_URL=

# Version minimale de l'app mobile (champ "version" de serveo-mobile/app.json).
# Les versions inferieures affichent un ecran bloquant "Mettre a jour" pointant
# vers NEXT_PUBLIC_ANDROID_APK_URL. Vide = pas de blocage.
MIN_MOBILE_APP_VERSION=

# Optionnel : alerte Telegram (gratuite) a la 1re occurrence de chaque erreur
# serveur, puis au plus une fois par heure et par erreur. Bot cree via
# @BotFather ; chat id = celui de la conversation avec le bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Utilisés uniquement par `pnpm db:seed`
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
